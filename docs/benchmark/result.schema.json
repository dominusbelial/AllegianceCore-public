          "enum": [
            1,
            2
          ]
        },
        "eventId": {
          "type": "string",
          "format": "uuid"
        },
        "installId": {
          "type": "string",
          "format": "uuid"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "gameVersion": {
          "type": "string",
          "maxLength": 80,
          "pattern": "^[a-zA-Z0-9.+_-]+$"
        },
        "commit": {
          "type": "string",
          "maxLength": 80,
          "pattern": "^(unknown|[0-9a-fA-F]{7,64})$"
        },
        "hardware": {
          "type": "object",
          "additionalProperties": false,
