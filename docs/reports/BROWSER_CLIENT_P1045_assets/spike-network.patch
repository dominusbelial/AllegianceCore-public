@@ -0,0 +1,32 @@
+#!/usr/bin/env bash
+set -euo pipefail
+export DOTNET="$HOME/.dotnet/dotnet" DOTNET_ROOT="$HOME/.dotnet"
+export ALLEGIANCE_ARTWORK_PATH="$(sed -n 's/^ALLEGIANCE_ARTWORK_PATH=//p' local.env)"
+export Lobby__Identity__ConnectionString="Data Source=$PWD/.scratch/p1045/lobby.db"
+export Lobby__Identity__SigningKeyFile="$PWD/.scratch/p1045/signing-key.pem"
+export Lobby__Identity__PublicKeyFile="$PWD/.scratch/p1045/public-key.pem"
+python3 - <<'CONFIG'
+import json,os
+from pathlib import Path
+Path('.scratch/p1045/server.json').write_text(json.dumps({"artPath":os.environ['ALLEGIANCE_ARTWORK_PATH'],"staticCore":"PCore001.igc","port":6045,"bindAddress":"127.0.0.1","updatesPerSecond":20,"sideSelectAutoSeatSeconds":2,"discovery":{"enabled":False},"games":[{"name":"Browser local proof","map":"XXV_simple.igc","teams":2,"civIds":[1,3],"sideNames":["Alpha","Bravo"]}]}))
+CONFIG
+gateway_pid=""
+cleanup(){
+ if [ -n "$gateway_pid" ]; then kill "$gateway_pid" 2>/dev/null || true; wait "$gateway_pid" 2>/dev/null || true; fi
+ scripts/dev-stack.sh down --name p1045
+}
+trap cleanup EXIT
+for i in 1 2 3; do
+ scripts/dev-stack.sh up --local --no-build --name p1045 --port 6045 --config "$PWD/.scratch/p1045/server.json"
+ "$DOTNET" .scratch/p1045/network/bin/Debug/net10.0/network.dll --gateway > .scratch/p1045/gateway.log 2>&1 &
+ gateway_pid=$!
+ for attempt in $(seq 1 100); do
+  if curl -s -o /dev/null http://127.0.0.1:8046/game; then break; fi
+  sleep 0.1
+ done
+ "$DOTNET" .scratch/p1045/network/bin/Debug/net10.0/network.dll > ".scratch/p1045/network-run$i.log" 2>&1
+ tail -1 ".scratch/p1045/network-run$i.log"
+ cleanup
+ gateway_pid=""
+done
+trap - EXIT
