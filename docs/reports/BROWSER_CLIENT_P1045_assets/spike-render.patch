diff --git a/.scratch/p1045/capture.cjs b/.scratch/p1045/capture.cjs
new file mode 100644
index 00000000..ff9c785f
--- /dev/null
+++ b/.scratch/p1045/capture.cjs
@@ -0,0 +1,29 @@
+const { chromium: playwright } = require('./npm/node_modules/playwright');
+
+const fs = require('fs');
+(async()=>{
+ const {default:chromium}=await import('./npm/node_modules/@sparticuz/chromium/build/index.js');
+ const results=[]; let version;
+  for(const [width,height] of [[1920,1080],[800,480]]){
+   const browser=await playwright.launch({executablePath:await chromium.executablePath(),args:chromium.args.filter(x=>!["--disable-web-security","--allow-running-insecure-content"].includes(x)),headless:true});
+   version=browser.version();
+   try {
+   const context=await browser.newContext({viewport:{width,height},deviceScaleFactor:1});
+   const page=await context.newPage();
+   await page.route('**/*',route=>/^http:\/\/127\.0\.0\.1:8045\//.test(route.request().url())?route.continue():route.abort());
+   page.on('console',m=>console.log('console:',m.type(),m.text()));page.on('pageerror',e=>console.log('pageerror:',e.message));
+   let bytes=0,requests=0;const cdp=await context.newCDPSession(page);await cdp.send('Network.enable');cdp.on('Network.loadingFinished',e=>{bytes+=e.encodedDataLength;requests++});
+   await page.goto('http://127.0.0.1:8045/',{waitUntil:'load'});
+   await page.waitForFunction(()=>window.measurements?.cpu?.length>=660,null,{timeout:120000});
+   const value=await page.evaluate(()=>{
+    const summary=a=>{a=a.slice(60).sort((a,b)=>a-b);return{count:a.length,medianMs:a[Math.floor(a.length*.5)],p95Ms:a[Math.floor(a.length*.95)],p99Ms:a[Math.floor(a.length*.99)]}};
+    const c=document.getElementById('theCanvas'),gl=c.getContext('webgl2')||c.getContext('webgl');
+    const ext=gl.getExtension('WEBGL_debug_renderer_info');
+    return{cpuTick:summary(measurements.cpu.slice(0,660)),rafInterval:summary(measurements.interval.slice(0,660)),firstFrameMs:measurements.firstFrameMs,renderer:ext?gl.getParameter(ext.UNMASKED_RENDERER_WEBGL):gl.getParameter(gl.RENDERER),webglVersion:gl.getParameter(gl.VERSION),resources:performance.getEntriesByType('resource').reduce((s,r)=>s+r.transferSize,0)};
+   });
+   await page.screenshot({path:`docs/reports/BROWSER_CLIENT_P1045_assets/render-${width}x${height}.png`});
+   results.push({width,height,httpEncodedBytes:bytes,requests,...value});console.log(JSON.stringify(results.at(-1)));
+   }finally{await browser.close();}
+  }
+  fs.writeFileSync('docs/reports/BROWSER_CLIENT_P1045_assets/render-metrics.json',JSON.stringify({browser:version,mode:'Headless, software SwiftShader; no GPU timing; fresh browser context per resolution; warmup 60 frames',results},null,2)+'\n');
+})().catch(e=>{console.error(e);process.exitCode=1});
