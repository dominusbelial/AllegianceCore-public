diff --git a/.scratch/p1045/render/Pages/Index.razor.cs b/.scratch/p1045/render/Pages/Index.razor.cs
new file mode 100644
index 00000000..1e9f9881
--- /dev/null
+++ b/.scratch/p1045/render/Pages/Index.razor.cs
@@ -0,0 +1,23 @@
+using Allegiance.Core;
+using Microsoft.JSInterop;
+namespace P1045Render.Pages;
+public partial class Index
+{
+    private P1045RenderGame? _game;
+    private DotNetObjectReference<Index>? _reference;
+    protected override async Task OnAfterRenderAsync(bool firstRender)
+    {
+        if (!firstRender) return;
+        using var http = new HttpClient { BaseAddress = new Uri(await JsRuntime.InvokeAsync<string>("baseUrl")) };
+        var mdl = MdlFile.Parse(await http.GetByteArrayAsync("art/fig05.mdl"));
+        var tex = MdlTextureDecoder.Decode(await http.GetByteArrayAsync("art/fig05bmp.mdl"));
+        _game = new P1045RenderGame(mdl, tex);
+        _reference = DotNetObjectReference.Create(this);
+        await JsRuntime.InvokeVoidAsync("initRenderJS", _reference);
+    }
+    [JSInvokable] public void TickDotNet()
+    {
+        if (!_game!.Started) { _game.Run(); _game.Started = true; }
+        _game.Tick();
+    }
+}
