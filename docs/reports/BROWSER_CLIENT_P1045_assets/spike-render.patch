@@ -0,0 +1,8 @@
+import http.server,sys
+from pathlib import Path
+class Handler(http.server.SimpleHTTPRequestHandler):
+ def __init__(self,*a,**kw): super().__init__(*a,directory=str(Path('.scratch/p1045/render-publish/wwwroot').resolve()),**kw)
+ def guess_type(self,path):
+  return 'application/wasm' if path.endswith('.wasm') else super().guess_type(path)
+ def log_message(self,*a):pass
+http.server.ThreadingHTTPServer(('127.0.0.1',8045),Handler).serve_forever()
