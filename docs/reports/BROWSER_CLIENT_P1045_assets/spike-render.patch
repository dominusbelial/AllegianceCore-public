--- /dev/null
+++ b/.scratch/p1045/inventory/Program.cs
@@ -0,0 +1,50 @@
+using Allegiance.Core;
+using Allegiance.Core.Model;
+string art = Environment.GetEnvironmentVariable("ALLEGIANCE_ARTWORK_PATH")!;
+var core = StaticCore.Load(IgcReader.Parse(File.ReadAllBytes(Path.Combine(art, "PCore001.igc"))));
+foreach (var hull in core.HullTypes.Values.Where(x => x.Name.Contains("Scout") || x.Name.Contains("Fighter") || x.Name.Contains("Lifepod")))
+    Console.WriteLine($"{hull.HullId} {hull.Name} model={hull.ModelName} texture={hull.TextureName}");
+var mdl = MdlFile.Parse(Path.Combine(art, args.Length>0 && !args[0].StartsWith("--") ? args[0] : "fig05.mdl"));
+Console.WriteLine($"Meshes={mdl.Meshes.Count} vertices={mdl.Meshes.Sum(m=>m.VertexCount)} tris={mdl.Meshes.Sum(m=>m.TriangleCount)} imports={string.Join(',',mdl.Namespaces)} textures={string.Join(',',mdl.Meshes.Select(m=>m.TextureStem))} unsupported={string.Join(',',mdl.UnsupportedGeometryNodes)}");
+if(args.Contains("--assets"))
+{
+    var files=Directory.EnumerateFiles(art).GroupBy(p=>Path.GetFileName(p),StringComparer.OrdinalIgnoreCase).Select(g=>g.First()).ToDictionary(p=>Path.GetFileName(p)!,p=>p,StringComparer.OrdinalIgnoreCase);
+    var groups=new Dictionary<string,SortedSet<string>>();
+    void Include(string group,string path){
+        if(!files.TryGetValue(path,out var full))return;
+        if(!groups.TryGetValue(group,out var set))groups[group]=set=new(StringComparer.OrdinalIgnoreCase);
+        string name=Path.GetFileName(full);
+        if(!set.Add(name))return;
+        if(!name.EndsWith(".mdl",StringComparison.OrdinalIgnoreCase))return;
+        try{var parsed=MdlFile.Parse(full);foreach(var ns in parsed.Namespaces)Include(group,ns+".mdl");}
+        catch(InvalidDataException){
+            var text=System.Text.Encoding.UTF8.GetString(File.ReadAllBytes(full));
+            foreach(System.Text.RegularExpressions.Match match in System.Text.RegularExpressions.Regex.Matches(text,"ImportImageFromFile\\s*\\(\\s*\"([^\"]+)\""))Include(group,match.Groups[1].Value);
+        }
+    }
+    void Model(string group,string stem){if(stem.Length==0)return;foreach(string suffix in new[]{".mdl","bmp.mdl",".cvh"})Include(group,stem+suffix);}
+    foreach(short hid in new short[]{14,15,18,33,3,114,121,131,113,107}){
+        var h=core.HullTypes[hid];Model("starter-hulls",h.ModelName);Model("starter-hulls",h.TextureName);
+    }
+    foreach(short cid in new short[]{1,3}){
+        var civ=core.Civilizations[cid];var station=core.StationTypes[civ.InitialStationTypeId];
+        Model("home-stations",station.ModelName);Model("home-stations",station.TextureName);
+    }
+    var map=MissionMap.Load(IgcReader.Parse(File.ReadAllBytes(Path.Combine(art,"XXV_simple.igc"))));
+    foreach(var cluster in map.Clusters){
+        Model("map-sky",cluster.PlanetName);Model("map-sky",cluster.PosterName);
+        if(int.TryParse(new string(cluster.PosterName.Where(char.IsDigit).ToArray()),out int number)){
+            Model("map-sky","globe"+number);Model("map-sky","environment"+number);
+        }
+    }
+    var homeCluster=map.Clusters.First(c=>c.Name=="Ceto");
+    Model("first-sector-sky",homeCluster.PlanetName);Model("first-sector-sky",homeCluster.PosterName);
+    if(int.TryParse(new string(homeCluster.PosterName.Where(char.IsDigit).ToArray()),out int firstNumber)){
+        Model("first-sector-sky","globe"+firstNumber);Model("first-sector-sky","environment"+firstNumber);
+    }
+    foreach(var warp in map.Warps){Model("warps",warp.TextureName);Model("warps",warp.IconName);}
+    foreach(string name in new[]{"PCore001.igc","XXV_simple.igc"})Include("core-map",name);
+    // A stated candidate UI subset. The production pack must be measured with both HUD styles.
+    foreach(string stem in new[]{"AmmoGauge","EnergyGauge","FuelGauge","HullGauge","ShieldGauge","ThrustGauge","chatmouse","chattext","chatcommand","chatshell","softgauge","creditbox","commandbkgnd","recipients","verbs","btnchangewing3","comaccept","comqueued","eye"})Model("hud-candidate",stem+"bmp");
+    Console.WriteLine(System.Text.Json.JsonSerializer.Serialize(groups));
+}
