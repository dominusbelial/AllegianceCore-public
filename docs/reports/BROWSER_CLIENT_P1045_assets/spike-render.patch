@@ -0,0 +1,8 @@
+const fs=require('fs'),p=require('path'),z=require('zlib');const base='.scratch/p1045/render-publish/wwwroot';
+function walk(dir){return fs.readdirSync(dir,{withFileTypes:true}).flatMap(x=>x.isDirectory()?walk(p.join(dir,x.name)):[p.join(dir,x.name)]);}
+const files=walk(base).filter(x=>!x.endsWith('.gz')&&!x.endsWith('.br'));
+const groups={};for(const file of files){const name=p.relative(base,file);const group=name.startsWith('_framework/')?'framework':name.startsWith('_content/')?'kniScripts':name.startsWith('art/')?'nativeArt':'shell';
+ const data=fs.readFileSync(file),g=groups[group]??={files:0,rawBytes:0,gzipBytes:0,brotliBytes:0};g.files++;g.rawBytes+=data.length;g.gzipBytes+=z.gzipSync(data,{level:9}).length;g.brotliBytes+=z.brotliCompressSync(data,{params:{[z.constants.BROTLI_PARAM_QUALITY]:11}}).length;
+}
+const output={configuration:'Release, net10.0, trimmed managed assemblies; no AOT, no runtime relink; assets individually gzip-9 / Brotli-11 estimated, static server served uncompressed',groups,totals:Object.fromEntries(['files','rawBytes','gzipBytes','brotliBytes'].map(key=>[key,Object.values(groups).reduce((s,g)=>s+g[key],0)]))};
+fs.writeFileSync('docs/reports/BROWSER_CLIENT_P1045_assets/bundle-metrics.json',JSON.stringify(output,null,2)+'\n');console.log(JSON.stringify(output));
