+++ b/.scratch/p1045/measure-assets.py
@@ -0,0 +1,27 @@
+from pathlib import Path
+import json,os,gzip,hashlib,collections
+root=Path(os.environ['ALLEGIANCE_ARTWORK_PATH'])
+repo=Path.cwd();dst=repo/'docs/reports/BROWSER_CLIENT_P1045_assets'
+groups=json.loads(Path('.scratch/p1045/art-groups.log').read_text().splitlines()[-1])
+# Resolve canonical spellings from the parser inventory. Inventory selection is stated,
+# not claimed to be a complete production first-match closure.
+files={}
+for name,names in groups.items():files[name]=[(root/n,'artwork/'+n) for n in names]
+files['font-sources']=[(p,'Content/Fonts/'+p.name) for p in (repo/'src/Allegiance.ClientCore.MonoGame/Content/Fonts').glob('*.ttf')]
+files['vfx-atlases']=[(p,'Content/Vfx/atlas/'+p.name) for p in (repo/'src/Allegiance.ClientCore.MonoGame/Content/Vfx/atlas').glob('*.png')]
+files['core-sounds']=[(root/(n+'.ogg'),'artwork/'+n+'.ogg') for n in ['accelsmall','sshipint','pulselaser','erbeam','alephloop','lrgslideout','mmissile','missilelock','missilelockonme','ef24','ef120','dropmine','dropobject','hitrock','hitshield','mount','hoover','receivechat','shieldup','noshld'] if (root/(n+'.ogg')).exists()]
+files['rock-surfaces']=[(root/(n+'.mdl'),'artwork/'+n+'.mdl') for n in ['bgrnd05bmp','bgrnd51bmp','bgrnd52bmp','bgrnd53bmp','bgrnd55bmp'] if (root/(n+'.mdl')).exists()]
+all_files=[p for p in root.rglob('*') if p.is_file() and '.git' not in p.relative_to(root).parts]
+full={'files':len(all_files),'rawBytes':sum(p.stat().st_size for p in all_files),'excluded':'.git'}
+manifest=[l.strip() for l in Path('packaging/artwork-manifest.txt').read_text().splitlines() if l.strip() and not l.startswith('#')]
+manifest_files=[root/p for p in manifest if (root/p).is_file()]
+existing={'manifest':'packaging/artwork-manifest.txt','entries':len(manifest),'present':len(manifest_files),'missing':len(manifest)-len(manifest_files),'rawBytesPresent':sum(p.stat().st_size for p in manifest_files)}
+result={}
+for name,paths in files.items():
+ entries=[]
+ for path,label in sorted(paths,key=lambda p:p[1]):
+  data=path.read_bytes();entries.append({'path':label,'rawBytes':len(data),'gzipBytes':len(gzip.compress(data,compresslevel=9,mtime=0)),'sha256':hashlib.sha256(data).hexdigest()})
+ result[name]={'files':len(entries),'rawBytes':sum(x['rawBytes'] for x in entries),'gzipBytes':sum(x['gzipBytes'] for x in entries),'entries':entries}
+obj={'note':'Candidate categories overlap by logical need, not a certified first-match closure. Fonts are source TTF cost, not a browser content bake. Gzip is per-file level 9, a measurement of compression only. No artwork binaries are included in this evidence JSON.','fullCorpus':full,'existingPlayerManifest':existing,'groups':result}
+(dst/'artwork-inventory.json').write_text(json.dumps(obj,indent=2)+'\n')
+print(json.dumps({'fullCorpus':full,'existingPlayerManifest':existing,'groups':{k:{x:v[x] for x in ['files','rawBytes','gzipBytes']} for k,v in result.items()}},indent=2))
diff --git a/.scratch/p1045/measure-bundle.cjs b/.scratch/p1045/measure-bundle.cjs
