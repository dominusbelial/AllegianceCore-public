<Project Sdk="Microsoft.NET.Sdk">

  <!-- Versions match tests/Allegiance.ClientCore.Tests exactly — inherited
       net10.0/TreatWarningsAsErrors from Directory.Build.props. -->

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <!-- P597 — corpus-backed tests skip (with a reason) when the external
         artwork/native corpus is absent on a clean clone. -->
    <PackageReference Include="Xunit.SkippableFact" Version="1.5.85" />
    <!-- The shared game library builds against the MonoGame API with
         PrivateAssets="All"; the test project supplies its own framework
         package so the 8 tests using MonoGame math types compile + run. -->
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.5.1" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- P597 — shared skip-helpers for corpus-backed tests (see TestRequire.cs). -->
  <ItemGroup>
    <Compile Include="../_shared/JsonDefaultsGuard.cs" Link="_shared/JsonDefaultsGuard.cs" />
    <Compile Include="../_shared/TestRequire.cs" Link="_shared/TestRequire.cs" />
    <Compile Include="../_shared/EconomyLoadoutTestSetup.cs" Link="_shared/EconomyLoadoutTestSetup.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../tools/fsr-proof/fsr-proof.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../../src/Allegiance.ClientCore.Game/Allegiance.ClientCore.Game.csproj" />
    <ProjectReference Include="../../src/Allegiance.Server/Allegiance.Server.csproj" />
    <ProjectReference Include="../../src/Allegiance.Bot/Allegiance.Bot.csproj" />
  </ItemGroup>

</Project>
