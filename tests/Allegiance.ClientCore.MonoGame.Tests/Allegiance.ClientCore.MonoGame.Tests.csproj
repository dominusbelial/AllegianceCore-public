<Project Sdk="Microsoft.NET.Sdk">

  <!-- Versions match tests/Allegiance.ClientCore.Tests exactly — inherited
       net10.0/TreatWarningsAsErrors from Directory.Build.props. -->

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <!-- The shared game library builds against the MonoGame API with
         PrivateAssets="All"; the test project supplies its own framework
         package so the 8 tests using MonoGame math types compile + run. -->
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.5.1" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Allegiance.ClientCore.Game/Allegiance.ClientCore.Game.csproj" />
    <ProjectReference Include="../../src/Allegiance.Server/Allegiance.Server.csproj" />
    <ProjectReference Include="../../src/Allegiance.Bot/Allegiance.Bot.csproj" />
  </ItemGroup>

</Project>
