<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.8.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <!-- P597 — corpus-backed tests skip (with a reason) when the external
         artwork/native corpus is absent on a clean clone. -->
    <PackageReference Include="Xunit.SkippableFact" Version="1.5.85" />
    <!-- CI-1 — CleanCloneSkipGuardTests parses tests/**/*.cs (syntax only). -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- P597 — shared skip-helpers for corpus-backed tests (see TestRequire.cs). -->
  <ItemGroup>
    <Compile Include="../_shared/JsonDefaultsGuard.cs" Link="_shared/JsonDefaultsGuard.cs" />
    <Compile Include="../_shared/TestRequire.cs" Link="_shared/TestRequire.cs" />
    <Compile Include="../_shared/EconomyLoadoutTestSetup.cs" Link="_shared/EconomyLoadoutTestSetup.cs" />
    <Compile Include="../_shared/DockTestPlacement.cs" Link="_shared/DockTestPlacement.cs" />
    <!-- P744 — hardware-relative perf-budget calibration (PerfCalibration). -->
    <Compile Include="../_shared/PerfCalibration.cs" Link="_shared/PerfCalibration.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Allegiance.Core\Allegiance.Core.csproj" />
    <ProjectReference Include="../../src/Allegiance.ClientCore/Allegiance.ClientCore.csproj" />
    <ProjectReference Include="..\..\src\Allegiance.Server\Allegiance.Server.csproj" />
    <ProjectReference Include="..\..\src\Allegiance.Bot\Allegiance.Bot.csproj" />
    <ProjectReference Include="..\..\src\Allegiance.Lobby\Allegiance.Lobby.csproj" />
    <!-- P812: the native-mesh ↔ glTF prototype tool (public API exercised directly) -->
    <ProjectReference Include="..\..\tools\mdl-to-glb\mdl-to-glb.csproj" />
    <!-- P870: native Core2Text/Text2Core static-core text round trip tool -->
    <ProjectReference Include="..\..\tools\core2txt\core2txt.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Fixtures/P817NativeGotoTrace.csv" />
  </ItemGroup>
</Project>