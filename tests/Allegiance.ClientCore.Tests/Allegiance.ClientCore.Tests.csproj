<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <!-- P597 — corpus-backed tests skip (with a reason) when the external
         artwork/native corpus is absent on a clean clone. -->
    <PackageReference Include="Xunit.SkippableFact" Version="1.5.85" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- P597 — shared skip-helpers for corpus-backed tests (see TestRequire.cs). -->
  <ItemGroup>
    <Compile Include="../_shared/TestRequire.cs" Link="_shared/TestRequire.cs" />
    <Compile Include="../_shared/EconomyLoadoutTestSetup.cs" Link="_shared/EconomyLoadoutTestSetup.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Allegiance.ClientCore/Allegiance.ClientCore.csproj" />
    <!-- Server reference exists ONLY so tests can boot a real in-process Srv;
         production code never references it. -->
    <ProjectReference Include="../../src/Allegiance.Core/Allegiance.Core.csproj" />
    <ProjectReference Include="../../src/Allegiance.Server/Allegiance.Server.csproj" />
    <!-- P426: prove the real hull/part name resolution in tools/allegiance-mcp
         against the same live PCore001.igc corpus (BotSpawnerResolutionTests). -->
    <ProjectReference Include="../../tools/allegiance-mcp/allegiance-mcp.csproj" />
  </ItemGroup>

</Project>
