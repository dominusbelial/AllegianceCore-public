<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <!-- P597 — corpus-backed tests skip (with a reason) when the external
         artwork/native corpus is absent on a clean clone. -->
    <PackageReference Include="Xunit.SkippableFact" Version="1.5.85" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../tools/skirmish-proof/skirmish-proof.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../../tools/p901-lan-proof/p901-lan-proof.csproj" ReferenceOutputAssembly="false" />
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- P597 — shared skip-helpers for corpus-backed tests (see TestRequire.cs). -->
  <ItemGroup>
    <Compile Include="../_shared/JsonDefaultsGuard.cs" Link="_shared/JsonDefaultsGuard.cs" />
    <Compile Include="../_shared/TestRequire.cs" Link="_shared/TestRequire.cs" />
    <Compile Include="../_shared/EconomyLoadoutTestSetup.cs" Link="_shared/EconomyLoadoutTestSetup.cs" />
    <Compile Include="../_shared/DockTestPlacement.cs" Link="_shared/DockTestPlacement.cs" />
    <!-- P744 — hardware-relative perf-budget calibration (PerfCalibration). -->
    <Compile Include="../_shared/PerfCalibration.cs" Link="_shared/PerfCalibration.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Allegiance.ClientCore/Allegiance.ClientCore.csproj" />
    <!-- TR-2 — the Single Player chooser and training screen models live in the MonoGame
         (ClientCore.Game) assembly; the intro/navigation screen-model tests need it. -->
    <ProjectReference Include="../../src/Allegiance.ClientCore.Game/Allegiance.ClientCore.Game.csproj" />
    <!-- Exercise the real server and owned single-player lifecycle; the
         ClientCore network library remains independent of hosting. -->
    <ProjectReference Include="../../src/Allegiance.Core/Allegiance.Core.csproj" />
    <ProjectReference Include="../../src/Allegiance.Server/Allegiance.Server.csproj" />
    <ProjectReference Include="../../src/Allegiance.SinglePlayer/Allegiance.SinglePlayer.csproj" />
    <!-- P426: prove the real hull/part name resolution in tools/allegiance-mcp
         against the same live PCore001.igc corpus (BotSpawnerResolutionTests). -->
    <ProjectReference Include="../../tools/allegiance-mcp/allegiance-mcp.csproj" />
  </ItemGroup>

</Project>
