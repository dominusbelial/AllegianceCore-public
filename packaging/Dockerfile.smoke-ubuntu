FROM ubuntu:24.04
# Stock distro dependencies only: no SDK or system .NET runtime.
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates libicu74 libssl3t64 libstdc++6 zlib1g \
    libgl1 libgl1-mesa-dri libopenal1 libasound2t64 libx11-6 \
    libxrandr2 libxi6 libxcursor1 libxinerama1 libxext6 libxrender1 \
    xvfb xauth coreutils findutils \
    && rm -rf /var/lib/apt/lists/*
