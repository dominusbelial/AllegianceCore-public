<Project Sdk="Microsoft.NET.Sdk">

  <!-- Offline modding CLI: native .mdl (+ .cvh) ↔ glTF .glb, inspect,
       optimize. Built by tools/build-tools.sh. Its output loads in the game.
       Tests: MdlToGlbTests, GlbToMdlTests, P824TexturePipelineTests,
       P919ModelToolsTests in tests/Allegiance.Core.Tests/. -->

  <ItemGroup>
    <ProjectReference Include="..\..\src\Allegiance.Core\Allegiance.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Allegiance.Tools.MdlToGlb</RootNamespace>
    <AssemblyName>mdl-to-glb</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

</Project>
