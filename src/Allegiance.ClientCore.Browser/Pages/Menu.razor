@page "/menu.html"
@implements IAsyncDisposable
@inject IJSRuntime JsRuntime
@inject HttpClient Http
@inject NavigationManager Nav

<span id="pacing-note" hidden role="status">Running slow · audio paused</span>
@if (SectorStatus.Length > 0) { <span id="sector-progress" role="status">@SectorStatus</span> }
<nav id="menu-controls" aria-label="Browser menu controls">
    <span>Browser game · @_style · @_persistence</span>
    <button aria-pressed="@(_style == Allegiance.ClientCore.MonoGame.Rendering.HudStyle.Classic ? "true" : "false")" disabled="@(_game is null)" @onclick="() => SetStyleAsync(Allegiance.ClientCore.MonoGame.Rendering.HudStyle.Classic)">Classic</button>
    <button aria-pressed="@(_style == Allegiance.ClientCore.MonoGame.Rendering.HudStyle.Modern ? "true" : "false")" disabled="@(_game is null)" @onclick="() => SetStyleAsync(Allegiance.ClientCore.MonoGame.Rendering.HudStyle.Modern)">Modern</button>
    <button id="online-open" disabled="@(_game is null || _online || _onlineBusy)" @onclick="OpenOnlineAsync">Play online</button>
    <button disabled="@(_game is null)" @onclick="EnableAudio">@_audioStatus</button>
    <button disabled="@(_game is null)" @onclick="ScreenshotAsync">Download screenshot</button>
</nav>
<div id="canvasHolder"><canvas id="theCanvas" tabindex="@(_game is null ? -1 : 0)" aria-label="Allegiance Game1 intro and Options"></canvas></div>
<div id="load-panel" class="panel" hidden="@(_game is not null && _error is null)" role="status" aria-live="polite">
    <h2>@(_error is null ? "Loading game menu" : "Game menu could not load")</h2>
    @if (_error is null)
    {
        <progress max="100" value="@_progress"></progress><p>@_status (@_progress%)</p>
    }
    else
    {
        <p>@_error</p><button id="retry" @onclick="LoadAsync">Retry</button>
    }
</div>

@if (_online)
{
    <section id="online-panel" class="@(_onlineState == "Flight" ? "flight-toolbar" : "panel")" aria-live="polite" data-state="@_onlineState">
        <p class="eyebrow">ALLEGIANCE · BROWSER GAME · @_style</p>
        <p id="online-identity">@IdentityLabel @if (_account is null) { <a href="@SignInHref()">Sign in / create account</a> }</p>
        <h2>@(_onlineState == "Servers" ? "Server list" : _onlineState == "Sides" ? "Choose a side" : _onlineState == "Flight" ? "In game" : _onlineState == "Hangar" ? "Hangar" : "Play online")</h2>
        @if (_onlineState == "Login")
        {
            <p>Play as a guest, or sign in or create an account. Signing in is optional.</p>
            @if (_browserEnabled) { <button id="online-play-now" class="primary" disabled="@_onlineBusy" @onclick="PlayGuestAsync">Play now</button> }
            <a id="online-signin" href="@SignInHref()">Sign in in this tab</a>
            <button id="online-refresh" disabled="@_onlineBusy" @onclick="OpenOnlineAsync">Refresh identity and servers</button>
        }
        else
        {
            @if (_guest && _onlineState == "Servers")
            {
                <article id="guest-disclosure">
                    <h3>Playing as a guest</h3>
                    <p>Your guest identity starts with a random callsign, saved only in this browser. Servers see your callsign while you play. Clearing site data or using another browser or device gives you a different pilot.</p>
                    <p>Your name is not reserved for you. Registered callsigns cannot be used as a guest on identity-enabled servers. Guest play does not add career or ladder stats to an account and gives you no account squad membership or reserved name.</p>
                    <p>You can sign in or create an account at any time. Signing in is optional.</p>
                    @if (!_guestPersistent) { <p id="guest-session-only">Browser storage is unavailable. This callsign lasts only for this page session.</p> }
                    <label>Guest callsign <input id="guest-callsign" maxlength="24" @bind="_guestEdit" @bind:event="oninput" disabled="@_onlineBusy" /></label>
                    <button id="guest-save" disabled="@_onlineBusy" @onclick="() => SaveGuestNameAsync()">Use this name</button>
                    <button id="guest-roll" disabled="@_onlineBusy" @onclick="() => SaveGuestNameAsync(true)">Roll a new name</button>
                    <button id="guest-forget" disabled="@_onlineBusy" @onclick="ForgetGuestAsync">Forget guest identity</button>
                </article>
            }
            @if (_onlineState == "Staging")
            { <progress max="100" value="@_progress"></progress><p>@_status</p>
              @if (_onlineError is not null) { <button id="join-retry" disabled="@_onlineBusy" @onclick="RetryStagingAsync">Retry</button> } }
            else if (_onlineState == "Servers")
            {
                @if (_servers.Any(s => s.PasswordRequired || (s.Missions?.Any(m => m.PasswordRequired) ?? false)))
                {
                    <label>Game password <input id="join-password" type="password" autocomplete="off" @bind="_joinPassword" @bind:event="oninput" /></label>
                }
                @foreach (var server in _servers)
                {
                    <article class="online-server" data-preselected="@(server.Id == _preselectServerId ? "true" : null)">
                        <strong>@server.Name</strong>
                        @if (server.Id == _preselectServerId) { <p class="preselected">Opened from the server list</p> }
                        @if (Unavailable(server) is { } reason) { <p>@reason</p><button class="online-join" disabled>@(reason == "Sign in to join" ? reason : "Join unavailable")</button> }
                        else if (server.Missions is { Length: > 0 } missions)
                        {
                            @foreach (var mission in missions)
                            {
                                <button class="online-join" disabled="@_onlineBusy" @onclick="() => JoinServerAsync(server, mission)">Join @mission.Name</button>
                            }
                        }
                        else { <button class="online-join" disabled="@_onlineBusy" @onclick="() => JoinServerAsync(server, null)">Join @server.MissionName</button> }
                    </article>
                }
                @if (_servers.Length == 0) { <p>No servers are listed.</p> }
            }
            else if (_onlineState == "Sides")
            {
                <p>@_onlineName · @_session?.ActiveTransportProtocol</p>
                @foreach (var side in _session?.World.SideRoster?.Sides ?? [])
                {
                    <button class="online-side" disabled="@_onlineBusy" @onclick="() => SelectSideAsync(side.SideId)">@side.Name · @side.PlayerCount players</button>
                }
            }
            @if (_onlineState is "Hangar" or "Flight")
            {
                <button id="online-briefing" @onclick="() => _showBriefing = !_showBriefing">Mission briefing</button>
                @if (_showBriefing)
                {
                    @if (OnlineBriefing() is { } briefing)
                    { <article id="mission-briefing"><h3>@briefing.Title</h3><p>@briefing.Objective</p><pre>@briefing.Body</pre></article> }
                    else { <p role="status">Waiting for mission briefing…</p> }
                }
            }
            @if (_onlineState == "Hangar")
            {
                var launch = LaunchAffordance();
                <p>@_onlineName · side @_session?.World.MySideId</p>
                <button id="online-launch" disabled="@(!launch.Enabled)" @onclick="LaunchOnlineAsync">Ready and launch current ship</button>
                @if (launch.Reason is not null) { <p id="launch-reason" role="status">@launch.Reason</p> }
            }
            else if (_onlineState == "Flight")
            {
                <p>@_onlineName · @_session?.ActiveTransportProtocol · server assigned ship</p>
                @if (_dev)
                {
                    <p id="online-pose">@_pose</p>
                }
                <p class="flight-help">W/S thrust · arrows turn · Space fire · Shift boost · click canvas for mouse steering · Escape releases · Alt+Enter fullscreen</p>
                <button id="flight-contact" @onclick="ToggleContactView">@(_game?.ViewingContact == true ? "Chase view" : "View nearby ships")</button>
                <button id="flight-watch" @onclick="ToggleWatch">@(_game?.Watching == true ? "Stop watching" : "Watch")</button>
                @if (_dev)
                {
                    <button id="flight-rock" @onclick="() => _game?.ToggleRockView()">View nearby asteroid</button>
                }
                @if (_game?.ViewingContact == true) { <button id="flight-angle" @onclick="() => _game?.RotateContactView()">Rotate view</button> }
                <button id="flight-dock" @onclick="DockHome">Dock at home station</button>
                <button id="flight-starmap" @onclick="() => _game?.ToggleStarmap()">Starmap</button>
                @if (_game?.StarmapOpen == true)
                {
                    <label>Sector <select id="map-sector" value="@_game.SelectedMapSector" @onchange="SelectMapSector">
                    @foreach (var cluster in (_session?.World.Clusters.Values.AsEnumerable() ?? []).OrderBy(c => c.Name))
                    { <option value="@cluster.ClusterId">@cluster.Name</option> }
                    </select></label>
                }
                <label>Aleph <select id="flight-warp" value="" @onchange="SelectWarp">
                    <option value="">Select destination</option>
                    @foreach (var warp in _session?.World.Warps.Values.Where(w => w.ClusterId == CurrentSector) ?? [])
                    { <option value="@warp.WarpId">@warp.Name</option> }
                </select></label>
                @if (_dev)
                {
                    <button id="flight-waypoint" @onclick="() => _showWaypoint = !_showWaypoint">Waypoint</button>
                    @if (_showWaypoint)
                    {
                        <label>X <input id="waypoint-x" type="number" step="any" @bind="_waypointX" /></label>
                        <label>Y <input id="waypoint-y" type="number" step="any" @bind="_waypointY" /></label>
                        <label>Z <input id="waypoint-z" type="number" step="any" @bind="_waypointZ" /></label>
                        <button id="waypoint-go" @onclick="() => { _game?.FlyToWaypoint(_waypointX, _waypointY, _waypointZ); _showWaypoint = false; }">Fly to waypoint</button>
                    }
                }
                <button id="flight-fullscreen" data-flight-fullscreen>Fullscreen</button>
            }
        }
        @if (_onlineBusy) { <p id="launch-status" role="status">@BusyStatus()</p> }
        @if (_onlineError is not null) { <p role="alert">@_onlineError</p> }
        @if (_nameConflict) { <button id="guest-try-another" disabled="@_onlineBusy" @onclick="TryAnotherNameAsync">Try another name</button> }
        <button id="online-close" @onclick="CloseOnlineAsync">Disconnect and return to menu</button>
    </section>
}
