<?xml version="1.0" encoding="utf-8"?>
<!--
  HUD small font — a clean monospace (DejaVu Sans Mono) baked at 14px for the
  HUD labels/numerals. Unicode ASCII printable range only (32..126); the HUD
  text never needs more than that. FONT-1: the .ttf is the repo-bundled copy
  (Content/Fonts/DejaVuSansMono.ttf), so the build needs no system font.
-->
<XnaContent xmlns:Graphics="Microsoft.Xna.Framework.Content.Pipeline.Graphics">
  <Asset Type="Graphics:FontDescription">
    <FontName>Fonts/DejaVuSansMono.ttf</FontName>
    <Size>14</Size>
    <Spacing>0</Spacing>
    <UseKerning>true</UseKerning>
    <Style>Regular</Style>
    <CharacterRegions>
      <CharacterRegion>
        <Start>&#32;</Start>
        <End>&#126;</End>
      </CharacterRegion>
    </CharacterRegions>
  </Asset>
</XnaContent>
