<Project Sdk="Microsoft.NET.Sdk">

  <!-- The DesktopGL HEAD of the shared MonoGame client. This project owns only
       the platform-specific parts: the entry point (Program.cs), the CLI flag
       parsing, the window, and the MGCB content build. All game code lives in
       the shared Allegiance.ClientCore.Game library it references.

       TargetFramework/Nullable/ImplicitUsings/TreatWarningsAsErrors all come
       from the repo-wide Directory.Build.props (net10.0, warnings-as-errors).

       Assembly name / exe name are UNCHANGED (Allegiance.ClientCore.MonoGame)
       so existing launch commands, docs and scripts keep working. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RollForward>Major</RollForward>
    <AssemblyName>Allegiance.ClientCore.MonoGame</AssemblyName>
    <RootNamespace>Allegiance.ClientCore.MonoGame</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Versions pinned to what dotnet restored from the 3.8.* wildcard on
         this machine: 3.8.5.1 (see docs/CLIENTCORE_MONOGAME_POC_P207.md). -->
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.5.1" />
    <PackageReference Include="MonoGame.Content.Builder.Task" Version="3.8.5.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- The shared game library provides Game1, the renderers and the wire
         session; the head adds the desktop entry point + content build. -->
    <ProjectReference Include="../Allegiance.ClientCore.Game/Allegiance.ClientCore.Game.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- P217 — the real quick-chat (SonicChat) system is parsed at runtime from
         the original's own data files, shipped verbatim as raw text into the
         Content directory (next to the built .xnb/.ogg assets). The default
         Content glob lists them as non-building None items; these lines make
         them actually land in the output Content/ dir so the parser can read
         them at startup alongside Content.Load's compiled assets. -->
    <None Update="Content/quickchat.mdl" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Content/sounddef.mdl" CopyToOutputDirectory="PreserveNewest" />

    <!-- P546 — the CC0 VFX atlas PNGs + licence files are OUR art (unlike the
         native .mdl artwork read from ALLEGIANCE_ARTWORK_PATH), so they ship
         verbatim in Content/ and load on a clean checkout with no artwork path
         set (VfxAssets reads them via TitleContainer.OpenStream at runtime and
         slices the grids). Copy the raw PNGs + licences into the output
         Content/Vfx/ tree. -->
    <None Update="Content/Vfx/atlas/*.png" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Content/Vfx/licenses/*" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Content/Vfx/README.md" CopyToOutputDirectory="PreserveNewest" />

    <!-- P547 — the compiled shader bytecode (.ogl.mgfxo) is OUR data (built
         from src/Allegiance.ClientCore.Game/Shaders/*.fx by
         scripts/build-shaders.sh on a Wine-equipped machine, committed). It
         ships verbatim in Content/ and the runtime ShaderAssetCache loads it
         via TitleContainer.OpenStream -> new Effect(gd, bytes), so the game
         builds AND runs with no Wine. The .fx sources stay in the shared Game
         library's Shaders/ folder (they are documentation/the rebuild input). -->
    <None Update="Content/Shaders/*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
