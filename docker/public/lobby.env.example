# P1061 — lobby settings for the public test host.
#
# These are the same values docker/public/docker-compose.yml sets. Keep this file
# as the readable reference when running the lobby outside compose (or when the
# production overlay changes). Placeholders: <public-origin> is the bare host
# name; never commit the real value, operator id or identity files.
ASPNETCORE_URLS=http://127.0.0.1:8080

# The one public origin, reached only through Caddy on 443.
Lobby__KnownProxies__0=127.0.0.1
Lobby__Identity__PublicUrl=https://<public-origin>
Lobby__Identity__Store=Sqlite
Lobby__Identity__ConnectionString=Data Source=/identity/accounts.db
Lobby__Identity__SigningKeyFile=/identity/signing-key.pem
Lobby__Identity__PublicKeyFile=/trust/public-key.pem
Lobby__Identity__OperatorAccountIds__0=<operator-account-id>
Lobby__Identity__GitHub__Enabled=false
Lobby__Identity__Google__Enabled=false
Lobby__Identity__Steam__Enabled=false

# Browser generation at /play/, served by this lobby outside the API limiter.
BrowserPreview__Enabled=true
BrowserPreview__Prefix=/play
BrowserPreview__BundlePath=/browser
BrowserPreview__ArtworkPath=/artwork
BrowserPreview__PublicOrigin=https://<public-origin>
BrowserPreview__WebSocketPath=/game
ALLEGIANCE_ARTWORK_PATH=/artwork

# STUN for the desktop client's NAT traversal.
Lobby__StunBindAddress=::
Lobby__StunPrimaryPort=3478
Lobby__StunSecondaryPort=3479
