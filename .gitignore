bin/
obj/
*.user
.vs/
.verify/

# P597 — private/local files must never be committed to the public repo:
# per-machine local path overrides (see local.env.example)
local.env
# untracked per-task server configs (some carried the owner's machine artPath
# and admin-cheats; use server.example*.json as the committed template)
src/Allegiance.Server/server.json
src/Allegiance.Server/server.p5*.json
# local docker overrides
docker-compose.override.yml

# live-proof scratch / working dirs (never committed)
.verify*/
/.scratch/
graphify-out/
roster_dump.json

# P499 — generated Android assets (from the P498 artwork manifest + the MGCB
# content build) are NOT committed; regenerate with scripts/pack-android-assets.sh.
src/Allegiance.ClientCore.Android/Assets/artwork/
src/Allegiance.ClientCore.Android/Assets/Content/

# Python bytecode caches (tools/space-objects, etc.)
__pycache__/
*.pyc

# P644 generated player archives and source cache
dist/

# TT-1 runner outputs (TRX, discovery manifests and per-tier summaries).
TestResults/

# HD4 sandbox-only scratch and external evidence substitute; never ship textures.
/.hd4-scratch/
/.hd4-evidence/

# BS-1 collector dependencies/build/local D1 state
/tools/bench-collector/node_modules/
/tools/bench-collector/generated/
/tools/bench-collector/dist/
/tools/bench-collector/.wrangler/
/tools/bench-collector/.dev.vars

# P748 sandbox fallback: scratch is removed; raw verification stays local.
/.p748-scratch/
/.p748-evidence/
.pi-sessions/
